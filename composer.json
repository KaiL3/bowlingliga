{
    "name": "bowlingliga/bowlingliga",
    "description": "Website for a bowling league: public standings and averages, admin area with 2FA, result entry via a virtual score sheet.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "chillerlan/php-qrcode": "^6.0",
        "ezyang/htmlpurifier": "^4.17",
        "mpdf/mpdf": "^8.2",
        "spomky-labs/otphp": "^11.2"
    },
    "suggest": {
        "thiagoalessio/tesseract_ocr": "^2.13 – only for the deferred OCR of score sheets (src/Ocr), not wired"
    },
    "require-dev": {
        "giorgiosironi/eris": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Bowlingliga\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bowlingliga\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "*": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:property": "phpunit --testsuite Property",
        "test:integration": "phpunit --testsuite Integration"
    }
}
